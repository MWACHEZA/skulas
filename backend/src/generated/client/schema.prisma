  tier1ApprovalRole          String? @default("BURSAR")
  tier2ApprovalRole          String? @default("SCHOOL_ADMIN")
  debtorLimit                Float?  @default(500.0)
  tillVarianceThreshold      Float?  @default(5.0)
  allowNegativeStock         Boolean @default(false)
  vatNumber                  String?
  vatRate                    Float?  @default(15.0)
  smtpEmail                  String?
  smtpHost                   String?
  smtpPort                   Int?    @default(465)
  smtpPassword               String?
  smtpSsl                    Boolean @default(true)
  systemUrl                  String?
  whatsappApiUrl             String?
  whatsappAccessToken        String?
  countryPhoneCode           String? @default("263")

