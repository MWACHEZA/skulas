model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // e.g. "CREATE_REQUISITION", "UPDATE_GRADE"
  entityType String // e.g. "Requisition", "Grade"
  entityId   String?
  details    Json?
  ipAddress  String?
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id])
  status     String   @default("SUCCESS")
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([actorId])
}

model Book {
  id              String    @id @default(cuid())
  title           String
  author          String
  authors         String[]  @default([])
  isbn            String?
  isbn10          String?
  isbn13          String?
  edition         String?
  publisher       String?
  price           Float?
  publishedDate   DateTime?
  description     String?
  status          String    @default("Available")
  shelfLocation   String?
  barcode         String?
  accessionNumber String?
  language        String?   @default("English")
  keywords        String[]  @default([])
  source          String?   @default("Purchased") // Purchased, Donated
  condition       String?   @default("Good") // New, Good, Fair, Damaged

  categoryId String?
  category   LibraryCategory? @relation(fields: [categoryId], references: [id])

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  classId String?
  class   SchoolClass? @relation(fields: [classId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  coverUrl     String?
  pdfUrl       String?
  copies       Int               @default(1)
  available    Int               @default(1)
  loans        BookLoan[]
  reservations BookReservation[]
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@index([schoolId])
}

model StudentHouse {
  id          String    @id @default(cuid())
  name        String
  description String?
  logo        String?
  color       String?
  motto       String?
  points      Int       @default(0)
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  students    Student[]

  houseMasterId String?
  houseMaster   Teacher? @relation("HouseMaster", fields: [houseMasterId], references: [id])

  houseCaptainId String?
  houseCaptain   Student? @relation("HouseCaptain", fields: [houseCaptainId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ChaplaincyEvent {
  id        String   @id @default(cuid())
  title     String
  type      String // ASSEMBLY, SUNDAY_SERVICE, MIDWEEK, SPECIAL
  date      DateTime
  theme     String
  status    String // PLANNED, CONFIRMED, ARCHIVED
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model Holiday {
  id        String   @id @default(cuid())
  title     String
  content   String?
  startDate DateTime
  endDate   DateTime
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model LibraryCategory {
  id               String                   @id @default(cuid())
  name             String
  schoolId         String
  school           School                   @relation(fields: [schoolId], references: [id])
  books            Book[]
  digitalResources LibraryDigitalResource[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

model BookLoan {
  id               String    @id @default(cuid())
  bookId           String
  book             Book      @relation(fields: [bookId], references: [id])
  studentId        String?
  student          Student?  @relation(fields: [studentId], references: [id])
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  borrowedAt       DateTime  @default(now())
  dueDate          DateTime
  returnedAt       DateTime?
  status           String    @default("borrowed") // borrowed, returned, overdue
  loanType         String    @default("LIBRARY") // LIBRARY, TEXTBOOK
  notes            String?
  accessionNumber  String?
  waivedFine       Float?    @default(0)
  paidFine         Float?    @default(0)
  fineCalculated   Float?    @default(0)
  lastReminderDate DateTime?
  lastReminderType String?
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([bookId])
}

model LibrarySetting {
  id                    String   @id @default(cuid())
  schoolId              String   @unique
  school                School   @relation(fields: [schoolId], references: [id])
  defaultLoanPeriodDays Int      @default(14)
  studentDailyFine      Float    @default(0.50)
  studentMaxFine        Float    @default(20.00)
  staffDailyFine        Float    @default(1.00)
  staffMaxFine          Float    @default(30.00)
  accrueOnWeekends      Boolean  @default(false)
  studentMaxLoans       Int      @default(3)
  staffMaxLoans         Int      @default(5)
  maxCopiesSameTitle    Int      @default(1)
  blockThresholdFine    Float    @default(10.00)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([schoolId])
}

model BookReservation {
  id          String    @id @default(cuid())
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id])
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  status      String    @default("Pending") // Pending, Approved, Ready for Pickup, Issued, Cancelled, Rejected
  requestDate DateTime  @default(now())
  notifiedAt  DateTime?
  readyAt     DateTime?
  issuedAt    DateTime?
  notes       String?
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId])
  @@index([bookId])
  @@index([studentId])
}

model LibraryDigitalResource {
  id                String           @id @default(cuid())
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id])
  title             String
  author            String
  resourceType      String // eBook, eJournal, Thesis, Video, Audio, Past Exam Paper, Report
  fileUrl           String?
  externalLink      String?
  fileFormat        String // PDF, MP4, MP3, Link, etc.
  categoryId        String?
  category          LibraryCategory? @relation(fields: [categoryId], references: [id])
  subjectId         String?
  subject           Subject?         @relation(fields: [subjectId], references: [id])
  accessLevel       String           @default("Public") // Public, Students Only, Staff Only, Private
  yearPublished     Int?
  description       String?
  keywords          String[]         @default([])
  language          String?          @default("English")
  thumbnailUrl      String?
  fileSize          BigInt?
  licenseStatus     String           @default("Open Access") // Restricted, Creative Commons, Open Access
  permissionGranted Boolean          @default(true)
  addedById         String?
  addedBy           User?            @relation("LibraryDigitalResourceAddedBy", fields: [addedById], references: [id])
  downloadCount     Int              @default(0)
  viewCount         Int              @default(0)
  expiryDate        DateTime?
  status            String           @default("Active") // Active, Inactive, Under Review
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

