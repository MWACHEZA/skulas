model Asset {
  id               String    @id @default(cuid())
  assetNumber      String? // System-generated unique e.g. AX-EMBAKWE-AST-0001
  name             String
  category         String // furniture, electronics, vehicles, stationery, books, etc.
  serialNumber     String?
  location         String?
  condition        String    @default("good") // good, fair, poor, condemned, damaged
  status           String    @default("ACTIVE") // ACTIVE, PENDING_APPROVAL, UNDER_MAINTENANCE, DISPOSED, TRANSFERRED, DAMAGED, LOST
  department       String? // library, clinic, science, kitchen, grounds, admin, etc.
  departmentId     String?
  quantity         Int       @default(1)
  purchaseDate     DateTime?
  purchasePrice    Float?
  supplierName     String?
  invoiceNumber    String?
  depreciationRate Float? // e.g. 10.0 for 10%/year
  warrantyExpiry   DateTime?
  photoUrl         String?

  custodianId String?
  custodian   User?   @relation("AssetCustodian", fields: [custodianId], references: [id])

  registeredById String?
  registeredBy   User?   @relation("AssetRegisteredBy", fields: [registeredById], references: [id])

  approvalStatus     String    @default("APPROVED") // PENDING_HOD, PENDING_BURSAR_ADMIN, APPROVED, REJECTED
  hodApprovedAt      DateTime?
  hodApprovedById    String?
  bursarApprovedAt   DateTime?
  bursarApprovedById String?
  adminApprovedAt    DateTime?
  adminApprovedById  String?
  rejectionReason    String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  incidents   AssetIncident[]
  maintenance AssetMaintenance[]

  nextMaintenance     DateTime?
  maintenanceInterval Int? // Interval in days
  attachments         Json? // [{name, url}] for receipts/warranties

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([custodianId])
  @@index([department])
  @@index([status])
}

model AssetIncident {
  id         String @id @default(cuid())
  assetId    String
  asset      Asset  @relation(fields: [assetId], references: [id])
  reporterId String
  reporter   User   @relation("IncidentReporter", fields: [reporterId], references: [id])

  issueType String // general, hardware, usage, theft
  details   String
  status    String @default("PENDING") // PENDING, RESOLVED

  resolvedBy  String?
  fixDetails  String?
  attachments Json? // [{name, url}] for proof of incident/fix

  schoolId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([reporterId])
}

model AssetMaintenance {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  scheduledDate DateTime
  performedDate DateTime?
  description   String
  attachments   Json? // [{name, url}] for proof of work
  cost          Float?
  notes         String? // Maintenance notes/recommendations

  schoolId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

