// Pharmacy Stock
model PharmacyStock {
  id          String             @id @default(cuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  drugName    String
  category    String             @default("MEDICATION")
  unit        String             @default("tablets")
  minStock    Int                @default(10)
  location    String?
  batches     PharmacyBatch[]
  dispensings PharmacyDispense[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([schoolId, drugName])
  @@index([schoolId])
}

// Pharmacy Batches (FEFO: First-Expiry-First-Out)
model PharmacyBatch {
  id          String             @id @default(cuid())
  schoolId    String
  stockId     String
  stock       PharmacyStock      @relation(fields: [stockId], references: [id], onDelete: Cascade)
  batchNumber String
  quantity    Int                @default(0)
  expiryDate  DateTime
  receivedAt  DateTime           @default(now())
  dispensings PharmacyDispense[]

  @@index([schoolId])
  @@index([stockId])
  @@index([expiryDate])
}

// Pharmacy Dispensing Log
model PharmacyDispense {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  visitId       String?
  visit         ClinicVisit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)
  stockId       String
  stock         PharmacyStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  batchId       String
  batch         PharmacyBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity      Int
  dispensedById String?
  dispensedBy   User?         @relation("PharmacyDispensedBy", fields: [dispensedById], references: [id], onDelete: SetNull)
  dispensedAt   DateTime      @default(now())

  @@index([schoolId])
  @@index([visitId])
}

// Clinic Beds (configurable count per tenant)
model ClinicBed {
  id         String            @id @default(cuid())
  schoolId   String
  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bedNumber  String
  ward       String            @default("Main Sick Bay")
  status     String            @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  notes      String?
  admissions ClinicAdmission[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([schoolId, bedNumber])
  @@index([schoolId])
}

// Clinic Admissions
model ClinicAdmission {
  id             String                @id @default(cuid())
  schoolId       String
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bedId          String
  bed            ClinicBed             @relation(fields: [bedId], references: [id], onDelete: Cascade)
  visitId        String?
  visit          ClinicVisit?          @relation(fields: [visitId], references: [id], onDelete: SetNull)
  studentId      String
  student        Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         String                @default("ADMITTED") // ADMITTED, DISCHARGED, TRANSFERRED
  dietNotes      String?
  dischargeNotes String?
  admittedAt     DateTime              @default(now())
  dischargedAt   DateTime?
  logs           ClinicMonitoringLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
}

// Clinic Monitoring Logs (configurable interval, default 4 hours)
model ClinicMonitoringLog {
  id           String          @id @default(cuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  admissionId  String
  admission    ClinicAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  temp         Float?
  bp           String?
  pulse        Int?
  spo2         Int?
  notes        String?
  recordedById String?
  recordedBy   User?           @relation("MonitoringLogRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt   DateTime        @default(now())

  @@index([schoolId])
  @@index([admissionId])
}

// Clinic Access Audit (who viewed or edited which student's clinical record, when)
model ClinicAccessAudit {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation("ClinicAccessAudits", fields: [userId], references: [id], onDelete: Cascade)
  action    String // VIEW_RECORD, EDIT_RECORD, VIEW_VITALS, DISPENSE_DRUG, ADMIT_PATIENT, DISCHARGE
  resource  String // e.g. "Visit #visit-123", "HealthProfile"
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([userId])
  @@index([createdAt])
}

// Clinic Emergency Log
model ClinicEmergencyLog {
  id                 String       @id @default(cuid())
  schoolId           String
  school             School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  visitId            String?
  visit              ClinicVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  studentId          String
  student            Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title              String
  description        String
  acuity             String       @default("RED") // RED, CRITICAL
  ambulanceCalled    Boolean      @default(false)
  ambulanceDetails   String?
  parentContacted    Boolean      @default(false)
  parentContactPhone String?
  parentContactNotes String?
  photoUrls          String[]     @default([]) // Private tenant-namespaced bucket signed URLs
  loggedById         String
  loggedBy           User         @relation("EmergencyLoggedBy", fields: [loggedById], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now())

  @@index([schoolId])
  @@index([studentId])
}

// Tenant Clinic Configuration
model ClinicSetting {
  id                      String   @id @default(cuid())
  schoolId                String   @unique
  school                  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hasDoctorQueue          Boolean  @default(false)
  bedCount                Int      @default(10)
  monitoringIntervalHours Int      @default(4)
  tempAlertThreshold      Float    @default(38.0)
  billingEnabled          Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// ●●● FISCALISATION, SEQUENCES, CREDIT NOTES & CASH-UP (PHASE 0/A/B/C/D) ●●●
// ═══════════════════════════════════════════════════════════════════

/// Tenant-scoped hardware / virtual fiscal devices registered with ZIMRA FDMS.
/// Sensitive credentials (activationKey, apiToken) are stored in server-only secrets (FiscalDeviceSecret).
model FiscalDevice {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  serialNo    String // Device serial e.g. "REV-00123"
  deviceModel String // e.g. "VIRTUAL_FDMS_V1", "FISCAL_BOX_202"
  location    String // e.g. "Tuckshop Till 1", "Uniform Shop", "Main Bursar Office"
  apiUrl      String // VFD / FDMS endpoint
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices     FiscalInvoice[]
  tillSessions TillSession[]
  secret       FiscalDeviceSecret?

  @@unique([schoolId, serialNo])
  @@index([schoolId])
  @@index([schoolId, isActive])
}

/// Server-only secret store for fiscal device credentials (activation key, API tokens).
/// Kept strictly separated from FiscalDevice and excluded from API serializers.
model FiscalDeviceSecret {
  id            String       @id @default(cuid())
  deviceId      String       @unique
  device        FiscalDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  schoolId      String
  activationKey String // Server-side encrypted or raw key
  apiToken      String? // Provider bearer token if applicable
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([schoolId])
}

/// Fiscal invoices emitted to ZIMRA FDMS.
model FiscalInvoice {
  id                 String          @id @default(cuid())
  schoolId           String
  school             School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  glTransactionId    String?
  glTransaction      JournalEntry?   @relation(fields: [glTransactionId], references: [id], onDelete: SetNull)
  deviceId           String
  device             FiscalDevice    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  receiptNo          String // Tenant-scoped sequence e.g. "RCPT-2026-00042"
  fiscalCode         String? // ZIMRA verification signature / fiscal day code
  fiscalDayNo        Int?
  qrCode             String? // ZIMRA verification QR code URL / raw string
  receiptHash        String?
  payload            Json? // Exact JSON payload dispatched to provider
  response           Json? // Exact response from provider
  status             String          @default("pending") // 'pending', 'fiscalised', 'failed'
  amount             Float // Gross amount (VAT inclusive)
  vatAmount          Float // Extracted VAT (15/115)
  currency           String          @default("USD")
  paymentMethod      String // 'CASH', 'ECOCASH', 'INNBUCKS', 'CARD', 'BANK'
  isCreditNote       Boolean         @default(false)
  originalFiscalId   String? // Link to original invoice if this is a FiscalCreditNote
  originalFiscal     FiscalInvoice?  @relation("FiscalReversal", fields: [originalFiscalId], references: [id])
  creditNoteInvoices FiscalInvoice[] @relation("FiscalReversal")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  creditNotes CreditNote[]

  @@unique([schoolId, receiptNo])
  @@index([schoolId])
  @@index([schoolId, deviceId])
  @@index([schoolId, status])
  @@index([schoolId, createdAt])
}

/// Atomic tenant-scoped document sequence generator.
/// Primary key / compound unique: (schoolId, prefix).
/// Guarantees that two schools never collide on invoice, receipt, or credit note numbers.
model DocumentSequence {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  prefix      String // 'INV', 'PAY', 'CN', 'DN', 'FISCAL', 'EXP', 'RCPT', 'TILL'
  description String?
  lastNumber  Int      @default(0)
  year        Int // e.g. 2026
  format      String   @default("{PREFIX}-{YEAR}-{NUMBER}") // e.g. "CN-2026-00001"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, prefix])
  @@index([schoolId])
}

/// Generalized credit notes for reversing posted transactions.
/// Strictly immutable; deletes are blocked on posted transactions.
model CreditNote {
  id                     String           @id @default(cuid())
  schoolId               String
  school                 School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creditNoteNumber       String // CN-2026-00001
  originalJournalEntryId String // Original JournalEntry.id
  reversalJournalEntryId String? // New reversing JournalEntry.id
  fiscalInvoiceId        String? // If original sale was fiscalised, links to new FiscalInvoice (CN)
  fiscalInvoice          FiscalInvoice?   @relation(fields: [fiscalInvoiceId], references: [id], onDelete: SetNull)
  reason                 String // e.g. "Item returned", "Billing error", "Customer refund"
  totalAmount            Float // Gross amount reversed
  totalVat               Float            @default(0)
  currency               String           @default("USD")
  issuedByUserId         String?
  status                 String           @default("ISSUED") // ISSUED | VOID
  lines                  CreditNoteLine[]
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@unique([schoolId, creditNoteNumber])
  @@index([schoolId])
  @@index([schoolId, originalJournalEntryId])
}

/// Line items in a generalized credit note (mirrors the original journal/sales lines).
model CreditNoteLine {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  schoolId     String
  coaCode      String
  amount       Float
  vatAmount    Float      @default(0)
  description  String?
  studentId    String?
  supplierId   String?
  createdAt    DateTime   @default(now())

  @@index([schoolId])
  @@index([creditNoteId])
}

/// Cash-up and till management sessions per device.
/// A device cannot perform sales without an OPEN till session.
model TillSession {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deviceId       String
  device         FiscalDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  sessionNumber  String // TILL-2026-00001
  openedByUserId String
  openedAt       DateTime     @default(now())
  closedByUserId String?
  closedAt       DateTime?
  openingFloat   Float        @default(0)
  closingCounted Float?
  expectedSales  Float?
  variance       Float?
  status         String       @default("OPEN") // 'OPEN', 'CLOSED', 'VARIANCE_REVIEW'
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  denominations CashupDenomination[]
  payments      CashupPayment[]

  @@unique([schoolId, sessionNumber])
  @@index([schoolId])
  @@index([schoolId, deviceId, status])
  @@index([schoolId, openedAt])
}

/// Cash counted denomination breakdown during cash-up.
model CashupDenomination {
  id            String      @id @default(cuid())
  schoolId      String
  tillSessionId String
  tillSession   TillSession @relation(fields: [tillSessionId], references: [id], onDelete: Cascade)
  currency      String      @default("USD")
  denomination  Float // 100, 50, 20, 10, 5, 2, 1, 0.5, 0.25, 0.1, 0.05
  count         Int
  total         Float
  createdAt     DateTime    @default(now())

  @@index([schoolId])
  @@index([tillSessionId])
}

/// Payment method summary and variance during cash-up.
model CashupPayment {
  id             String      @id @default(cuid())
  schoolId       String
  tillSessionId  String
  tillSession    TillSession @relation(fields: [tillSessionId], references: [id], onDelete: Cascade)
  paymentMethod  String // 'CASH', 'ECOCASH', 'INNBUCKS', 'CARD', 'BANK'
  expectedAmount Float // Sum from sales / fiscal_invoices
  countedAmount  Float // Physically counted / e-wallet balance confirmed
  variance       Float // counted - expected
  createdAt      DateTime    @default(now())

  @@index([schoolId])
  @@index([tillSessionId])
}

/// Cross-module student clearance checklist (Library, Fees, Hostel).
model StudentClearance {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String  @default("PENDING") // 'PENDING', 'APPROVED', 'REJECTED'

  // Library sign-off
  libraryCleared  Boolean   @default(false)
  libraryNotes    String?
  librarySignedBy String?
  librarySignedAt DateTime?

  // Fees / Finance sign-off
  feesCleared  Boolean   @default(false)
  feesBalance  Float     @default(0)
  feesNotes    String?
  feesSignedBy String?
  feesSignedAt DateTime?

  // Hostel / Boarding sign-off
  hostelCleared  Boolean   @default(false)
  hostelNotes    String?
  hostelSignedBy String?
  hostelSignedAt DateTime?

  // Final Admin / Bursar Clearance
  finalCleared  Boolean   @default(false)
  finalSignedBy String?
  finalSignedAt DateTime?
  certificateNo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, studentId])
  @@index([schoolId])
  @@index([schoolId, status])
}

// --- Phase 1: Attendance Models ---

model AttendanceRegister {
  id        String             @id @default(cuid())
  schoolId  String
  classId   String
  date      DateTime
  session   String // Morning, Afternoon, Evening
  submitted Boolean            @default(false)
  locked    Boolean            @default(false)
  records   AttendanceRecord[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([schoolId, classId, date, session])
}

model AttendanceRecord {
  id         String             @id @default(cuid())
  registerId String
  register   AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  studentId  String
  status     String // Present, Absent, Late, Sick, AuthorizedLeave, Truant
  notes      String?
  time       DateTime           @default(now())

  @@unique([registerId, studentId])
}

model PeriodAttendance {
  id                String    @id @default(cuid())
  studentId         String
  timetablePeriodId String
  date              DateTime
  status            String
  scannedAt         DateTime?

  @@unique([studentId, timetablePeriodId, date])
}

model QrCodeSession {
  id           String   @id @default(cuid())
  teacherId    String
  classId      String?
  periodId     String?
  date         DateTime
  code         String   @unique
  expiresAt    DateTime
  locationData Json?
  createdAt    DateTime @default(now())
}

model Syllabus {
  id           String  @id @default(cuid())
  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  form         String
  url          String?
  uploadedById String?
  uploadedBy   User?   @relation("SyllabusUploader", fields: [uploadedById], references: [id])

  topics SyllabusTopic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([subjectId])
}

model SyllabusTopic {
  id           String    @id @default(cuid())
  syllabusId   String
  syllabus     Syllabus  @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  code         String?
  topic        String
  expectedWeek Int?
  objectives   String?
  isCovered    Boolean   @default(false)
  coveredAt    DateTime?
  coveredById  String?
  coveredBy    User?     @relation("SyllabusCoveredBy", fields: [coveredById], references: [id])

  schemes SchemeOfWork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syllabusId])
}

model SchemeOfWork {
  lessonPlans     LessonPlan[]
  id              String        @id @default(cuid())
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  form            String
  term            Int
  year            Int
  status          String        @default("draft") // draft/pending/approved/rejected
  comments        String?
  syllabusTopicId String
  syllabusTopic   SyllabusTopic @relation(fields: [syllabusTopicId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@index([subjectId])
}

model LessonPlan {
  id              String       @id @default(cuid())
  schoolId        String
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schemeId        String
  scheme          SchemeOfWork @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  date            DateTime
  objectives      String?
  flow            String?
  resources       String?
  assessment      String?
  homework        String?
  differentiation String?
  reflection      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([schemeId])
}
