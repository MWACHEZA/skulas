  systemTitle                     String?
  shortSystemName                 String?
  systemEmail                     String?
  phone                           String?
  address                         String?
  mapLocation                     String?
  mapLatitude                     Float?
  mapLongitude                    Float?
  paypalEmail                     String?
  systemCurrency                  String?   @default("USD")
  runningSession                  String? // Academic year e.g. 2024-2025
  weekends                        String[]  @default(["Saturday", "Sunday"])
  currentTerm                     String?
  nextTermBegin                   DateTime?
  language                        String?   @default("English")
  timezone                        String?   @default("UTC")
  tawktoPropertyId                String?
  theme                           String?   @default("Blue")
  textAlignment                   String?   @default("Left-to-right")
  themeColour                     String?   @default("All white")
  enableParentMarketplace         Boolean   @default(false)
  deletePaymentHistoryWithPartial Boolean   @default(false)
  footer                          String?
  country                         String?
  state                           String?
  city                            String?
  facebook                        String?
  twitter                         String?
  youtube                         String?
  instagram                       String?
  linkedin                        String?
  tiktok                          String?
  reportCardTemplate              String?
  allowTeacherEnterScores         Boolean   @default(false)
  scoreClosingDate                DateTime?
  allowStudentCheckResult         Boolean   @default(false)
  allowParentPrintReport          Boolean   @default(false)
  reportCommentSignature          String?
  showSubjectPosition             Boolean   @default(false)

