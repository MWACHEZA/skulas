  submittedAt  DateTime   @default(now())
  startedAt    DateTime? // To track when the timer started for the student
  status       String     @default("SUBMITTED") // SUBMITTED, GRADED, LATE, IN_PROGRESS
  grade        Float?
  autoScore    Float? // Computed score for online quizzes
  feedback     String?
  gradedAt     DateTime?
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([schoolId])
  @@index([assignmentId])
  @@index([studentId])
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String
  image       String?
  category    String?
  author      String?
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
}

