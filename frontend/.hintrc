{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]",
          "meta[name=apple-mobile-web-app-capable]",
          "meta[name=apple-mobile-web-app-status-bar-style]"
        ]
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "scrollbar-width",
          "scrollbar-width: thin",
          "scrollbar-width: auto",
          "scrollbar-width: none",
          "scrollbar-color"
        ]
      }
    ]
  }
}
